{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gearnest-client",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "account_id": "1d46eaac6b7c875ec2ab4a90a5e0a2fe",
  "vars": {
    "MONGODB_DB": "gearnest",
    "BETTER_AUTH_URL": "https://gearnest.sraboni.dev",
    "API_URL": "https://api.gearnest.sraboni.dev",
    "NEXT_PUBLIC_API_URL": "https://api.gearnest.sraboni.dev"
  },
  "routes": [
    {
      "pattern": "gearnest.sraboni.dev",
      "custom_domain": true
    }
  ]
}
